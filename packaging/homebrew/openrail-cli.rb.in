# SPDX-License-Identifier: MIT
#
# Homebrew formula for the openrail CLI. Generated by
# packaging/homebrew/update-tap.sh from packaging/homebrew/openrail-cli.rb.in in
# the openrail repository; edit the template there, not this file.
#
# The formula is named openrail-cli because a Homebrew formula name becomes a
# Ruby class name, which cannot start with a digit. The tap also carries the
# alias openrail, so `brew install musakkka/tap/openrail` works too.
class OpenrailCli < Formula
  desc "Command-line client for openrail, the self-hosted app platform"
  homepage "https://openrail.app"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "@URL_BASE@/v#{version}/openrail-cli_#{version}_darwin_arm64.tar.gz"
      sha256 "@SHA256_DARWIN_ARM64@"
    end
    on_intel do
      url "@URL_BASE@/v#{version}/openrail-cli_#{version}_darwin_amd64.tar.gz"
      sha256 "@SHA256_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "@URL_BASE@/v#{version}/openrail-cli_#{version}_linux_arm64.tar.gz"
      sha256 "@SHA256_LINUX_ARM64@"
    end
    on_intel do
      url "@URL_BASE@/v#{version}/openrail-cli_#{version}_linux_amd64.tar.gz"
      sha256 "@SHA256_LINUX_AMD64@"
    end
  end

  def install
    bin.install "openrail"
    generate_completions_from_executable(bin/"openrail", "completion")
  end

  def caveats
    <<~EOS
      Log in to your install with:
        openrail login https://<your console>

      To run Railway CLI commands against openrail, add the railway alias:
        ln -s "#{opt_bin}/openrail" "#{HOMEBREW_PREFIX}/bin/railway"
    EOS
  end

  test do
    ENV["FIFTY_CONFIG"] = testpath/"config.json"
    assert_match "v#{version}", shell_output("#{bin}/openrail version")
    assert_match "openrail", shell_output("#{bin}/openrail completion bash")
  end
end
