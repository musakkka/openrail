# SPDX-License-Identifier: MIT
[Unit]
Description=openrail control plane
Documentation=https://openrail.app/docs
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=FIFTY_CONFIG=/etc/5050/config.json
ExecStart=/opt/5050/current/5050d serve --config /etc/5050/config.json
Restart=always
RestartSec=2
TimeoutStopSec=30
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
